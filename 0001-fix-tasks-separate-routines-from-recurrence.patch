diff --git a/src/db/dexie/__tests__/taskRelationshipMigration.test.ts b/src/db/dexie/__tests__/taskRelationshipMigration.test.ts
new file mode 100644
index 0000000..92e9948
--- /dev/null
+++ b/src/db/dexie/__tests__/taskRelationshipMigration.test.ts
@@ -0,0 +1,40 @@
+import Dexie from "dexie";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { taskRecord } from "@/test/factories";
+import { AliosDatabase } from "../db";
+import {
+  DEXIE_DATABASE_NAME,
+  DEXIE_SCHEMA_V10,
+  DEXIE_TABLE_NAMES,
+} from "../schema";
+
+describe("Task relationship migration", () => {
+  beforeEach(async () => {
+    await Dexie.delete(DEXIE_DATABASE_NAME);
+  });
+
+  afterEach(async () => {
+    await Dexie.delete(DEXIE_DATABASE_NAME);
+  });
+
+  it("keeps routineId and clears recurrenceSeriesId without deleting the task", async () => {
+    const legacyDatabase = new Dexie(DEXIE_DATABASE_NAME);
+    legacyDatabase.version(10).stores(DEXIE_SCHEMA_V10);
+    await legacyDatabase.table(DEXIE_TABLE_NAMES.tasks).add({
+      ...taskRecord,
+      routineId: "routine-id",
+      recurrence: { frequency: "daily" },
+      recurrenceSeriesId: "series-id",
+    });
+    legacyDatabase.close();
+
+    const migratedDatabase = new AliosDatabase();
+    const tasks = await migratedDatabase.tasks.toArray();
+
+    expect(tasks).toHaveLength(1);
+    expect(tasks[0]?.routineId).toBe("routine-id");
+    expect(tasks[0]?.recurrenceSeriesId).toBeUndefined();
+    migratedDatabase.close();
+  });
+});
