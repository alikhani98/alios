+    .filter((file): file is string => typeof file === "string" && file.endsWith(".md"))
+    .map((file) => join(docsDirectory, file));
+
+  return [...rootFiles, ...docsFiles];
+}
+
+describe("Markdown encoding", () => {
+  it.each(markdownFiles())("keeps %s as clean UTF-8 without a BOM", (file) => {
+    const content = readFileSync(file);
+
+    expect(content.subarray(0, 3)).not.toEqual(Buffer.from([0xef, 0xbb, 0xbf]));
+    expect(content.toString("utf8")).not.toMatch(mojibakePattern);
+  });
+});
